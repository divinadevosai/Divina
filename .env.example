# ── AI (Phase 2) ─────────────────────────────────────────────────────
# Without a key DIVINA runs on the local command engine and the browser voice.
GEMINI_API_KEY=
# Optional. If a model is retired, Divina asks Google for the newest Flash model itself.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_VOICE=Charon

# ── Desktop bridge (Phase 5) — macOS or Windows, OFF unless set to 1 ─
# DIVINA_DESKTOP_BRIDGE=1

# ── Modules (Phase 3) ────────────────────────────────────────────────
# Weather: browser location is used when granted; otherwise one of these.
# DIVINA_CITY=Lisbon
# DIVINA_LAT=38.72
# DIVINA_LON=-9.14

# Calendar: your calendar's secret iCal address (or drop data/calendar.ics)
# DIVINA_CALENDAR_ICS=https://calendar.google.com/calendar/ical/.../basic.ics

# Instagram: IGAA… (Instagram Login) or EAA… (Facebook Login + account id)
# INSTAGRAM_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_API_VERSION=v23.0

# Sports league, ESPN path form
# One league or several, separated by commas (ESPN codes, up to 6)
# DIVINA_LEAGUE=soccer/eng.1, soccer/esp.1, basketball/nba

# News topic
# DIVINA_NEWS_TOPIC=AI

# Optional: higher GitHub rate limit for Projects
# GITHUB_TOKEN=
